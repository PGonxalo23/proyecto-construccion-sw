import tkinter as tk

# Ventana principal
ventana = tk.Tk()
ventana.title("Calculadora")
ventana.geometry("350x500")
ventana.resizable(False, False)
ventana.configure(bg="#202124")

# Pantalla
pantalla = tk.Entry(
    ventana,
    font=("Arial", 28),
    justify="right",
    bg="#303134",
    fg="white",
    insertbackground="white",
    borderwidth=0
)
pantalla.pack(fill="x", padx=15, pady=20, ipady=15)


def agregar(valor):
    pantalla.insert(tk.END, valor)


def borrar():
    pantalla.delete(0, tk.END)


def calcular():
    try:
        resultado = eval(pantalla.get())
        pantalla.delete(0, tk.END)
        pantalla.insert(0, str(resultado))
    except:
        pantalla.delete(0, tk.END)
        pantalla.insert(0, "Error")


# Marco de botones
marco = tk.Frame(ventana, bg="#202124")
marco.pack(expand=True, fill="both", padx=15, pady=10)

botones = [
    ("7", 0, 0), ("8", 0, 1), ("9", 0, 2), ("/", 0, 3),
    ("4", 1, 0), ("5", 1, 1), ("6", 1, 2), ("*", 1, 3),
    ("1", 2, 0), ("2", 2, 1), ("3", 2, 2), ("-", 2, 3),
    ("0", 3, 0), (".", 3, 1), ("C", 3, 2), ("+", 3, 3),
]

for texto, fila, columna in botones:

    if texto == "C":
        comando = borrar
        color = "#d93025"
    else:
        comando = lambda valor=texto: agregar(valor)
        color = "#3c4043"

    boton = tk.Button(
        marco,
        text=texto,
        command=comando,
        font=("Arial", 20, "bold"),
        bg=color,
        fg="white",
        activebackground="#5f6368",
        activeforeground="white",
        borderwidth=0
    )

    boton.grid(
        row=fila,
        column=columna,
        sticky="nsew",
        padx=4,
        pady=4
    )


# Botón igual
boton_igual = tk.Button(
    marco,
    text="=",
    command=calcular,
    font=("Arial", 20, "bold"),
    bg="#1a73e8",
    fg="white",
    activebackground="#4285f4",
    borderwidth=0
)

boton_igual.grid(
    row=4,
    column=0,
    columnspan=4,
    sticky="nsew",
    padx=4,
    pady=4
)

# Hacer que los botones se adapten al tamaño
for i in range(5):
    marco.rowconfigure(i, weight=1)

for i in range(4):
    marco.columnconfigure(i, weight=1)


ventana.mainloop()
